{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "paths": {
      "@verimod/protocol/*": [
        "./shared/protocol/src/*"
      ],
      "@vm-domain/*": [
        "./frontend/src/domain/*"
      ]
    }
  },
  "include": [
    "server",
    "shared",
    "test"
  ],
  "exclude": [
    "upstream"
  ]
}
