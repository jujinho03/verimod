# ---- 브라우저(Vite) 공개 설정: 비밀값을 넣지 마세요 ----
VITE_BASE_SEPOLIA_CONTRACT_ADDRESS=0x<approved-contract>
VITE_BASE_SEPOLIA_PUBLISHER=0x<approved-publisher>
VITE_BASE_SEPOLIA_RPC_URLS=https://<public-rpc-1>,https://<public-rpc-2>
VITE_BASE_SEPOLIA_DEPLOYMENT_BLOCK=<deployment-block-number>
VITE_BASE_SEPOLIA_MIN_CONFIRMATIONS=12

# ---- 수집·세션 서비스(server/, 포트 3101) 환경변수: 셸 또는 .env.local로 주입, 커밋 금지 ----
# REDESIGN_SVC_PORT=3101
# REDESIGN_DB_PATH=./.data/redesign-dev.sqlite        # 이 앱 전용 개발 DB
# VERIMOD_BACKEND_URL=http://127.0.0.1:3001            # 기존 backend(로컬 주소만 허용)
# YOUTUBE_API_KEY=<server-only secret>                 # 없으면 YouTube 수집 unavailable
# GEMINI_API_KEY=<server-only secret>                  # 없으면 의미 기반 선택 unavailable
# GEMINI_MODEL=gemini-2.5-flash
# VERIMOD_R01_PACKAGE=C:/path/to/VeriMod_R01_Model_Handoff
# VERIMOD_PYTHON=C:/path/to/ai/.venv/Scripts/python.exe
# REDESIGN_STOP_AFTER_UNAVAILABLE=3
