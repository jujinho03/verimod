{
  "name": "verimod-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src e2e *.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "w5:browser": "playwright test --config=playwright.w5.config.ts",
    "w6:browser": "playwright test --config=playwright.w6.config.ts",
    "w6:rpc-recovery": "playwright test --config=playwright.w6-recovery.config.ts",
    "w5:typecheck": "tsc -p tsconfig.w5-tools.json",
    "w5:rpc-smoke": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/w5-readonly-smoke.mts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/tasa-orbiter": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@verimod/protocol": "file:../shared/protocol",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
