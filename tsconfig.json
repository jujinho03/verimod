{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@verimod/protocol/*": [
        "./shared/protocol/src/*"
      ],
      "@vm-domain/*": [
        "./frontend/src/domain/*"
      ],
      "@vm-api/*": [
        "./frontend/src/api/*"
      ],
      "@vm-ui/*": [
        "./frontend/src/ui/*"
      ],
      "@vm-features/*": [
        "./frontend/src/features/*"
      ]
    }
  },
  "include": [
    "src",
    "shared"
  ],
  "exclude": [
    "upstream"
  ]
}
