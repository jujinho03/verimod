# Copy to .env locally. Never commit the real file.
# Both RPC URLs are transport configuration only, not a TrustProfile authority.
VERIMOD_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VERIMOD_BASE_SEPOLIA_BACKUP_RPC_URL=https://base-sepolia-rpc.publicnode.com

# Use a dedicated Base Sepolia test wallet only. Do not paste a real wallet key.
# VERIMOD_DEPLOYER_PRIVATE_KEY=0x...
# Optional deployment guard. When set it must be the address derived from the key above.
# VERIMOD_PUBLISHER_ADDRESS=0x...

# W4 actual epoch sender. F must provide these values only after its SQLite freeze.
# VERIMOD_ANCHOR_ADDRESS=0xd17ba590b23e984e3f3408bcdc3529be9868ec50
# VERIMOD_EPOCH_ID=1
# VERIMOD_EPOCH_ROOT=0x...
# VERIMOD_EPOCH_COUNT=1
# VERIMOD_PROTOCOL_VERSION=1
